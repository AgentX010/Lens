generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

/// A single observed price — a trade, or a snapshot of a pool's state.
///
/// Identity (#237): a retried ingest batch, or two ingester instances
/// overlapping during a deploy, must not store the same observation twice —
/// duplicated trades inflate volume and skew the volume-weighted VWAP. The
/// unique index below makes a duplicate impossible rather than unlikely.
///
/// eventId is nullable, and Postgres treats NULLs as distinct in a unique
/// index, so the constraint only binds "where eventId exists". That is why
/// upsertPricePoints (src/db.ts) never stores a null: venues that hand back a
/// natural id (SDEX/AMM trade TOIGs, Horizon trade ids) keep it verbatim, and
/// sources with none — AMM/Soroswap pool snapshots, Aquarius, anything added
/// later — get a key synthesized deterministically from the row's content,
/// never from a clock. See synthesizeEventId in src/db.ts and
/// scripts/migrations/2026-10-17-price-point-identity.sql, which removes rows
/// already duplicated on this identity before the index is created.
model PricePoint {
  id            String   @default(uuid())
  network       String   @default("testnet")
  assetA        String   @map("asset_a")
  assetB        String   @map("asset_b")
  pairKey       String   @map("pair_key")
  source        String
  poolId        String?  @map("pool_id")
  price         Decimal  @db.Decimal(36, 18)
  baseVolume    Decimal  @map("base_volume")  @db.Decimal(36, 7)
  counterVolume Decimal  @map("counter_volume") @db.Decimal(36, 7)
  ledger        Int
  timestamp     DateTime
  eventId       String?  @map("event_id")

  @@id([id, timestamp])
  @@unique([network, source, eventId], map: "price_point_identity")
  @@index([network, pairKey, timestamp(sort: Desc)])
  @@index([network, pairKey, source, timestamp(sort: Desc)])
  @@map("price_points")
}

/// Latest supply/borrow interest rate an asset earns or costs at one lending
/// venue, written by the rate ingester (Blend, see L079) and read verbatim by
/// GET /rates/:asset.
///
/// Every row is scoped to a `network` exactly like price_points: mainnet and
/// testnet rates are separate series and are never pooled. `venue` and `source`
/// name where the number came from, and `poolId`/`poolName` record the specific
/// market it came from so a response can attribute each rate instead of
/// silently averaging a live market with a dead one.
model LendingRate {
  id          String   @default(uuid())
  network     String   @default("testnet")
  asset       String
  assetIssuer String?  @map("asset_issuer")
  /// Lending venue the rate was read from (e.g. "blend").
  venue       String
  /// Distinct source tag stored on the row, mirroring price_points.source.
  source      String
  /// Contract id of the pool/market the rate came from — never elided.
  poolId       String   @map("pool_id")
  poolName     String?  @map("pool_name")
  /// APY earned by supplying the asset, as a fraction (0.05 == 5%).
  supplyRate    Decimal  @map("supply_rate") @db.Decimal(18, 8)
  /// APY charged to borrow the asset, as a fraction (0.07 == 7%).
  borrowRate    Decimal  @map("borrow_rate") @db.Decimal(18, 8)
  ledger        Int
  timestamp     DateTime

  @@id([id, timestamp])
  @@index([network, asset, timestamp(sort: Desc)])
  @@index([network, asset, venue, timestamp(sort: Desc)])
  @@map("lending_rates")
}

model PoolSnapshot {
  id          String   @default(uuid())
  network      String   @default("testnet")
  poolId      String   @map("pool_id")
  assetA       String   @map("asset_a")
  assetB       String   @map("asset_b")
  reserveA     Decimal  @map("reserve_a") @db.Decimal(36, 7)
  reserveB     Decimal  @map("reserve_b") @db.Decimal(36, 7)
  spotPrice    Decimal  @map("spot_price") @db.Decimal(36, 18)
  totalShares Decimal? @map("total_shares") @db.Decimal(36, 7)
  feeBp       Int      @default(30)  @map("fee_bp")
  ledger        Int
  timestamp     DateTime

  @@id([id, timestamp])
  @@index([network, poolId, timestamp(sort: Desc)])
  @@map("pool_snapshots")
}

model PriceAggregate {
  pairKey     String   @map("pair_key")
  network     String   @default("testnet")
  window      String
  bucket      DateTime
  vwap        Decimal  @db.Decimal(36, 18)
  sdexVwap    Decimal? @map("sdex_vwap")  @db.Decimal(36, 18)
  ammVwap     Decimal? @map("amm_vwap")   @db.Decimal(36, 18)
  volume      Decimal  @default(0)  @db.Decimal(36, 7)
  sdexVolume  Decimal? @default(0) @map("sdex_volume")  @db.Decimal(36, 7)
  ammVolume   Decimal? @default(0) @map("amm_volume")   @db.Decimal(36, 7)
  tradeCount  Int?     @default(0) @map("trade_count")
  openPrice   Decimal? @map("open_price")  @db.Decimal(36, 18)
  closePrice  Decimal? @map("close_price") @db.Decimal(36, 18)
  highPrice    Decimal? @map("high_price")   @db.Decimal(36, 18)
  lowPrice     Decimal? @map("low_price")    @db.Decimal(36, 18)

  @@id([network, pairKey, window, bucket])
  @@map("price_aggregates")
}

/// Audit record for one published aggregate (#512).
///
/// Written in the same transaction as the PriceAggregate upsert, so a
/// published aggregate and its audit record are always present together. The
/// inputs array is capped at AUDIT_MAX_INPUTS in src/pricing/audit.ts — the
/// cap is enforced at write time, not just documented, so storage growth is
/// bounded per aggregate regardless of source count.
///
/// The primary key mirrors PriceAggregate so a past timestamp can be looked
/// up by (network, pairKey, window, bucket) with the same key the aggregate
/// itself uses.
///
/// Retention: the writer prunes rows older than AUDIT_RETENTION_DAYS (by bucket)
/// on every flush, so the table is bounded by time as well as by the per-row
/// input cap. See docs/database-schema.md.
model PriceAggregateAudit {
  network       String   @default("testnet")
  pairKey       String   @map("pair_key")
  window        String
  bucket        DateTime
  /// Aggregation method name (e.g. "vwap-deviation").
  method        String
  /// Method parameters (e.g. {"deviationThreshold":0.05}).
  params        Json     @default("{}")
  /// Inputs used by the aggregate, capped at AUDIT_MAX_INPUTS at write time.
  inputs        Json     @default("[]")
  /// Inputs rejected by the aggregate, each with its reason.
  rejected      Json     @default("[]")
  /// Total inputs considered before the cap was applied.
  inputCount    Int      @map("input_count")
  /// Total inputs rejected before the cap was applied.
  rejectedCount Int      @map("rejected_count")
  /// Whether the inputs array was truncated by the cap.
  truncated     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  @@id([network, pairKey, window, bucket])
  @@index([bucket(sort: Desc)])
  @@map("price_aggregate_audits")
}
